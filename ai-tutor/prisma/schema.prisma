generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions", "fullTextSearch"]
  output          = "../src/generated/prisma"
}

datasource db {
  provider   = "postgresql"
  extensions = [vector]
}

model User {
  id                String           @id @default(cuid())
  email             String           @unique
  emailVerified     DateTime?
  name              String?
  passwordHash      String?
  image             String?
  role              UserRole         @default(STUDENT)
  languagePreference String          @default("en")
  sessionVersion    Int              @default(0)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  deletedAt         DateTime?

  accounts          Account[]
  sessions          Session[]
  studentProfile    StudentProfile?
  teacherProfile    TeacherProfile?
  conversations     Conversation[]
  documents         Document[]
  quizzes           Quiz[]
  aiUsage           AiUsage[]
  mastery           Mastery[]
  oneTimePasswords  OneTimePassword[]
  notebooks         Notebook[]
  topicVideos       TopicVideo[]

  @@index([email])
  @@index([role])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum OtpPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

model OneTimePassword {
  id         String     @id @default(cuid())
  userId     String?
  email      String
  purpose    OtpPurpose
  codeHash   String
  attempts   Int        @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime   @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([email, purpose])
  @@index([expiresAt])
}

enum UserRole {
  STUDENT
  TEACHER
  ADMIN
}

model StudentProfile {
  id              String  @id @default(cuid())
  userId          String  @unique
  educationLevel  String?
  gradeLevel      String?
  subjects        Json?
  preferences     Json?
  learningStyle   String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TeacherProfile {
  id              String  @id @default(cuid())
  userId          String  @unique
  institution     String?
  department      String?
  qualifications  Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Subject {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  icon        String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  topics         Topic[]
  conversations  Conversation[]
  quizzes        Quiz[]

  @@index([slug])
}

model Topic {
  id              String   @id @default(cuid())
  subjectId       String
  parentTopicId   String?
  name            String
  slug            String
  description     String?
  sortOrder       Int      @default(0)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  subject         Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  parentTopic     Topic?       @relation("TopicHierarchy", fields: [parentTopicId], references: [id])
  childTopics     Topic[]      @relation("TopicHierarchy")
  mastery         Mastery[]
  quizzes         Quiz[]

  @@unique([subjectId, slug])
  @@index([subjectId])
}

model Mastery {
  id              String   @id @default(cuid())
  userId          String
  topicId         String
  score           Float    @default(0)
  totalAttempts   Int      @default(0)
  correctAttempts Int      @default(0)
  lastAssessedAt  DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([userId, topicId])
  @@index([userId])
  @@index([topicId])
}

model Conversation {
  id          String   @id @default(cuid())
  userId      String
  subjectId   String?
  title       String?
  summary     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user     User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject  Subject?  @relation(fields: [subjectId], references: [id])
  messages Message[]

  @@index([userId])
}

model Message {
  id              String   @id @default(cuid())
  conversationId  String
  role            MessageRole
  content         String   @db.Text
  tokensUsed      Int      @default(0)
  metadata        Json?
  createdAt       DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

model Document {
  id           String       @id @default(cuid())
  userId       String
  filename     String
  originalName String
  mimeType     String
  sizeBytes    Int
  storagePath  String
  status       DocumentStatus @default(PENDING)
  errorMessage String?
  metadata     Json?
  createdAt    DateTime     @default(now())
  processedAt  DateTime?

  user   User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  chunks DocumentChunk[]

  @@index([userId])
  @@index([status])
}

enum DocumentStatus {
  PENDING
  PROCESSING
  READY
  ERROR
}

model DocumentChunk {
  id           String   @id @default(cuid())
  documentId   String
  content      String   @db.Text
  embedding    Unsupported("vector(1536)")?
  chunkIndex   Int
  metadata     Json?
  tokenCount   Int      @default(0)
  createdAt    DateTime @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
}

model Quiz {
  id          String   @id @default(cuid())
  userId      String
  subjectId   String?
  topicId     String?
  title       String?
  questions   Json
  answers     Json?
  score       Float?
  totalPoints Float?
  timeSpent   Int?
  status      QuizStatus @default(PENDING)
  createdAt   DateTime @default(now())
  completedAt DateTime?

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject Subject? @relation(fields: [subjectId], references: [id])
  topic   Topic?   @relation(fields: [topicId], references: [id])

  @@index([userId])
}

enum QuizStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

model AiUsage {
  id              String   @id @default(cuid())
  userId          String
  provider        String
  model           String
  requestTokens   Int      @default(0)
  responseTokens  Int      @default(0)
  estimatedCost   Float    @default(0)
  feature         String?
  latencyMs       Int      @default(0)
  createdAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

// NotebookLM-backed study material. `lmId` is the id Google assigns in the
// connected NotebookLM account; local ids are never sent to Google.
model Notebook {
  id        String   @id @default(cuid())
  userId    String
  lmId      String
  title     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  sources   NotebookSource[]
  artifacts NotebookArtifact[]

  @@unique([userId, lmId])
  @@index([userId])
}

model NotebookSource {
  id         String   @id @default(cuid())
  notebookId String
  lmId       String
  title      String?
  kind       String   @default("unknown")
  url        String?
  content    String?  @db.Text
  status     String   @default("pending")
  error      String?
  createdAt  DateTime @default(now())

  notebook Notebook @relation(fields: [notebookId], references: [id], onDelete: Cascade)

  @@unique([notebookId, lmId])
  @@index([notebookId])
}

model NotebookArtifact {
  id         String   @id @default(cuid())
  notebookId String
  lmId       String
  kind       String
  title      String?
  status     String   @default("pending")
  content    String?  @db.Text
  error      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  notebook Notebook @relation(fields: [notebookId], references: [id], onDelete: Cascade)

  @@unique([notebookId, lmId])
  @@index([notebookId])
}

enum TopicVideoStatus {
  PENDING
  PROCESSING
  READY
  ERROR
}

model TopicVideo {
  id              String           @id @default(cuid())
  userId          String
  topic           String
  status          TopicVideoStatus @default(PENDING)
  summary         String?          @db.Text
  script          String?          @db.Text
  sections        Json?
  sources         Json?
  audioPath       String?
  videoPath       String?
  durationSeconds Float?
  errorMessage    String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}
